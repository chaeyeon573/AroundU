{
  "expo": {
    "name": "AroundU",
    "slug": "aroundu",
    "version": "0.1.0",
    "scheme": "aroundu",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.aroundu.mobile"
    },
    "android": {
      "package": "app.aroundu.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-font",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "AroundU가 시간표 이미지를 사진에 저장합니다.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    }
  }
}
