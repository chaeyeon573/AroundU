# ─── 프론트엔드 (빌드 시점에 Vite 가 읽음) ───────────────────────────────
# mock  = 브라우저 localStorage 위 예시 데이터 (기본)
# remote = server/ 를 사용. Railway 에서 프론트+API 를 한 서비스로 띄우면 remote 로 두고 VITE_API_URL 은 비운다
VITE_API_MODE=remote
# 다른 origin 의 API 를 쓸 때만 (예: https://aroundu-api.up.railway.app). 같은 서비스면 비워둔다
VITE_API_URL=

# ─── 서버 (server/index.ts) ────────────────────────────────────────────
# Railway Postgres 플러그인을 붙이면 자동으로 주입된다. 없으면 server/.data/db.json 파일에 저장
DATABASE_URL=
PORT=8787
# 시드 데이터·알림 문구 언어: ko | en  (미국 캠퍼스 데모·수업 목록은 en)
AROUNDU_LANG=en
# 1 이면 예시 사용자가 친구 요청 수락·채팅 답장 등을 자동으로 한다 (데모용). 실제 운영에서는 0
DEMO_AUTOREPLY=0
# 0 이면 "로그인 (데모 계정)" 버튼이 서버에서 거부된다
ALLOW_DEMO_LOGIN=1
# 1 이면 설정 → 데모 데이터 초기화가 서버 DB 를 시드로 되돌린다. 운영에서는 비워둔다
ALLOW_RESET=
# 학교 이메일 인증 코드 발송 (https://resend.com). 비어 있으면 코드를 응답 힌트에 그대로 보여준다 (개발용)
RESEND_API_KEY=
MAIL_FROM="AroundU <login@yourdomain.com>"
# 메일 미설정 상태에서도 코드를 힌트로 노출하지 않으려면 1
HIDE_DEV_CODE=
# 0 이면 가입 이메일이 학교 도메인(@berkeley.edu 등)과 일치하지 않아도 허용
VERIFY_EMAIL_DOMAIN=1
# 프론트를 다른 도메인에서 서빙할 때만 (쉼표로 여러 개)
CORS_ORIGIN=
